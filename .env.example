# إعدادات بوت ذاكر — انسخ الملف إلى .env ثم املأ القيم المطلوبة.
# لا ترفع ملف .env إلى GitHub ولا تشارك التوكن أو مفاتيح الخدمات.

# القيم الإلزامية
BOT_TOKEN=123456789:AAExampleTokenReplaceThisValue
OWNER_ID=123456789
STORAGE_CHANNEL=-1001234567890

# قاعدة البيانات: SQLite افتراضيًا. استخدم PostgreSQL خارجيًا عند الحاجة.
DATABASE_URL=sqlite+aiosqlite:///./data/library_bot.db

# الملفات والنسخ الاحتياطية
MAX_UPLOAD_MB=20
REQUIRE_REVIEW=true
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Telegram Bot API محلي اختياري لدعم الملفات الكبيرة
BOT_API_BASE=

# بيانات تعريفية اختيارية
DEVELOPER_NAME=
BOT_VERSION=1.0.0

# OCR — اترك OCR_LANGS فارغًا للكشف التلقائي
OCR_LANGS=
OCR_DEWARP=true
EXAM_PDF_MAX_MB=10

# الذكاء الاصطناعي — اختياري؛ لا يلزم لتشغيل المكتبة والبحث والرفع
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TEMPERATURE=0.6
AI_TIMEOUT=60

# مفاتيح مزودين منفصلة اختيارية عند الحاجة:
# AI_API_KEY_OPENAI=
# AI_API_KEY_GEMINI=
# AI_API_KEY_GROQ=
# AI_API_KEY_OPENROUTER=

# نموذج التضمين الدلالي اختياري
EMBEDDING_MODEL=
