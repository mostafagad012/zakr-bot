# ===========================================================================
#  إعدادات بوت «ذاكر» — انسخ الملف ده إلى .env واملأ أول 3 أسطر بس
#
#      cp .env.example .env
#
#  البوت بيشتغل كامل بدون أي مفتاح ذكاء اصطناعي.
# ===========================================================================

# ------------------------------------------------ إلزامي (3 أسطر)
# 1) التوكن من @BotFather  (ابعت /newbot)
BOT_TOKEN=123456789:AAExampleReplaceMeWithYourOwnToken

# 2) رقمك في تيليجرام من @userinfobot — بلا هذا مش هتكون مالك البوت
OWNER_ID=123456789

# 3) قناة/جروب خاص لتخزين الملفات (البوت لازم يكون أدمن فيها)
#    عامة:  STORAGE_CHANNEL=@my_channel
#    خاصة:  STORAGE_CHANNEL=-1001234567890
STORAGE_CHANNEL=-1001234567890

# ------------------------------------------------ اختياري: قاعدة البيانات
# الافتراضي SQLite في ./data — كافي لمكتبة متوسطة.
# DATABASE_URL=sqlite+aiosqlite:///./data/library_bot.db
# على السحابة (Railway) استخدم PostgreSQL خارجيًا بمنفذ 5432:
# DATABASE_URL=postgresql+asyncpg://postgres:PASS@db.xxxx.supabase.co:5432/postgres

# ------------------------------------------------ اختياري: الحدود والتخزين
# MAX_UPLOAD_MB=20
# REQUIRE_REVIEW=1          # 0 = نشر الملفات بلا موافقة مشرف
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BOT_VERSION=1.0.0
# DEVELOPER_NAME=

# ------------------------------------------------ اختياري: OCR
# فارغ = كشف اللغة تلقائيًا
# OCR_LANGS=ara+eng
# OCR_DEWARP=1              # فكّ التواء صور الموبايل قبل القراءة
# EXAM_PDF_MAX_MB=10        # سقف ملف الامتحان (أقل من سقف الرفع)

# ===========================================================================
#  الذكاء الاصطناعي — اختياري تمامًا
#
#  الأسهل: ما تعدّلش هنا. افتح البوت:
#      🤖 الذكاء الاصطناعي  ←  🔑 إدارة المفاتيح  ←  ➕ مفتاح groq
#  والبوت يكتب السطر بنفسه بالاسم الصحيح ويعمل فورًا.
#
#  أو اكتب يدويًا بالشكل: <اسم المزوّد>_api_key
#      openai_api_key=sk-...
#      gemini_api_key=AIza...
#      groq_api_key=gsk_...
#      deepseek_api_key=sk-...
#  (الصيغة القديمة AI_API_KEY_GEMINI ما زالت مقروءة — لا تكسرها)
# ===========================================================================

# المزوّد النشط: openai | gemini | groq | deepseek | openrouter | ollama | ...
# auto = اختر أول مزوّد له مفتاح
AI_PROVIDER=auto

# مفتاح عام (يكفي لوحده لمزوّد واحد) — أو استخدم <name>_api_key أعلاه
# AI_API_KEY=

# موديل محدّد (فارغ = الافتراضي للمزوّد)
# AI_MODEL=

# عنوان API مخصّص — لازم لمزوّد custom أو موديل محلي
# AI_BASE_URL=http://localhost:11434/v1

# AI_TEMPERATURE=0.6
# AI_TIMEOUT=60

# ═══════════════════════════════════════════════════════════════════
#  متغيّرات متقدّمة — كلها اختيارية، وغيابها لا يكسر شيئًا
# ═══════════════════════════════════════════════════════════════════

# سيرفر Bot API محلي — يرفع حدّ حجم الملف من 20 ميجا إلى 2 جيجا.
# تحتاجه فقط لو رفعت ملفات ضخمة. اتركه فاضيًا للتخزين العادي.
# BOT_API_BASE=http://localhost:8081

# نموذج البحث الدلالي العصبي (يحتاج fastembed + ~2 جيجا رام عند التحميل).
# البوت يعمل بدونه ويتراجع تلقائيًا إلى TF-IDF.
# EMBEDDING_MODEL=minishlab/potion-multilingual-128M

# مسار نموذج فكّ التواء صور الموبايل (UVDoc). الافتراضي models/uvdoc.onnx
# لا يعمل على أندرويد (لا onnxruntime) — يُتخطّى بهدوء هناك.
# UVDOC_MODEL_PATH=./models/uvdoc.onnx

# مسار ملف الإعدادات لو أردت اسمًا غير .env (نادرًا ما تحتاجه)
# ENV_FILE_PATH=./.env

# ── OCR على لوحات الاستضافة (Wispbyte) ────────────────────────────
# مجلد tesseract المنزَّل محليًا. يضبطه ocr_fetch.py تلقائيًا — لا تعدّله.
# TESSDATA_PREFIX=/home/container/.ocr/usr/share/tesseract-ocr/5/tessdata

# امسح هذا السطر (اجعله =1) لتخطّي تنزيل OCR تمامًا وتوفير ~27 ميجا.
# البوت يعمل بدونه: الصور المصوّرة لن تُقرأ، لكن الرفع لا يفشل.
# ZAKR_SKIP_OCR=1
